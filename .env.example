# AEGIS environment template. Copy to .env and fill in real values.
NODE_ENV=development

# Infra
POSTGRES_URL=postgres://aegis:aegis_dev_password@127.0.0.1:5432/aegis
REDIS_URL=redis://127.0.0.1:6379

# Frontend/public origin (your own domain in production)
PUBLIC_ORIGIN=http://localhost:5173

# Orchestrator JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m

# Encryption key for API-key vault (32 bytes hex, 64 chars)
VAULT_KEY=change-me-32-byte-hex-key-change-me-32-byte

# Scan chain endpoints (JSON-RPC)
RPC_URL=http://127.0.0.1:8545

# Relayer signing: keys come from environment/KMS only, never in source
# RELAYER_PRIVATE_KEY=

# Telegram operator monitoring
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=